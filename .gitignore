# Config Firebase per-environment. JANGAN commit langsung — ambil dari
# Firebase Console lalu taruh manual di app/google-services.json, atau
# (untuk CI) lewat GitHub Secret GOOGLE_SERVICES_JSON (lihat workflow).
app/google-services.json

# Keystore: jangan commit keystore produksi sungguhan.
# app/sekretaris-kkn.jks saat ini TETAP ditrack (lihat catatan di
# build.gradle.kts) karena dipakai GitHub Actions untuk build rilis
# dengan tanda tangan yang konsisten antar build. Jika nanti keystore
# dipindah ke GitHub Secrets, hapus baris pengecualian di bawah ini.
!app/sekretaris-kkn.jks
app/google-services.json
