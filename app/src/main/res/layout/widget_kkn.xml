<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_akar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_judul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KKN Al-Mushlih 2027"
        android:textColor="#FF9AA0BF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_sholat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sholat"
        android:textColor="#FFF4F5FB"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_sisa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF2BD4A0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_proker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#FFC3C8E3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_pengingat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFB84D"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
