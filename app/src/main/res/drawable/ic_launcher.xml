<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon aplikasi: pictogram desa (kumpulan rumah + bukit + matahari) gaya
  flat modern, memakai gradasi warna brand app (Violet -> Pink, sama
  seperti GradUtama di Color.kt) supaya konsisten dengan tampilan di
  dalam aplikasi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Latar gradasi ungu -> pink -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#5B4BDB"
                android:endColor="#D92B6B" />
        </aapt:attr>
    </path>

    <!-- Matahari -->
    <path android:fillColor="#FFB84D" android:pathData="M86,26m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />

    <!-- Bukit lembut di belakang -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.14"
        android:pathData="M-4,92 C20,76 40,100 54,86 C68,72 90,96 112,84 L112,112 L-4,112 Z" />

    <!-- Rumah kiri (lebih kecil, di belakang) -->
    <path android:fillColor="#FFFFFF" android:pathData="M14,82 L14,58 L27,43 L40,58 L40,82 Z" />
    <path android:fillColor="#8B7BFF" android:pathData="M20,64h5v7h-5z" />

    <!-- Rumah kanan (lebih kecil, di belakang) -->
    <path android:fillColor="#FFFFFF" android:pathData="M68,82 L68,58 L81,43 L94,58 L94,82 Z" />
    <path android:fillColor="#8B7BFF" android:pathData="M83,64h5v7h-5z" />

    <!-- Rumah tengah (lebih besar, di depan) -->
    <path android:fillColor="#FFFFFF" android:pathData="M35,88 L35,52 L54,30 L73,52 L73,88 Z" />
    <!-- Pintu -->
    <path android:fillColor="#5B4BDB" android:pathData="M48,70h12a2,2 0,0 1,2 2v16h-16v-16a2,2 0,0 1,2 -2z" />
    <!-- Jendela -->
    <path android:fillColor="#FFB84D" android:pathData="M41,58h8v8h-8z" />
    <path android:fillColor="#FFB84D" android:pathData="M59,58h8v8h-8z" />

    <!-- Garis tanah -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.9" android:pathData="M8,88h92v4h-92z" />
</vector>
