<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hanya dipakai untuk: (1) cek versi terbaru di GitHub Releases,
         (2) unduh APK update. Semua data operasional tetap offline di Room. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dibutuhkan agar app bisa memicu instalasi APK update yang baru diunduh -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Kamera & galeri: dibutuhkan agar peserta KKN bisa memotret/memilih
         foto untuk diunggah sebagai bagian dari database kegiatan
         (nota, dokumentasi, dll). READ_EXTERNAL_STORAGE hanya berlaku
         sampai Android 12 (API 32); Android 13+ pakai READ_MEDIA_IMAGES. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SekretarisApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SekretarisKKN"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SekretarisKKN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Menerima hasil pemasangan update senyap dari sistem -->
        <receiver
            android:name=".update.HasilUpdateReceiver"
            android:exported="false" />

        <!-- FileProvider: dipakai untuk membagikan foto nota (share) dan
             untuk membuka file APK hasil unduhan update agar bisa diinstal. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
